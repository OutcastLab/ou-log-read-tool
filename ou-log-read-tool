#!/usr/bin/env python3
"""
ou-log-read-tool - defensive web access-log analyzer (Apache / Nginx).

Detects common attack indicators (SQLi, XSS, path traversal, command injection,
sensitive-file discovery, scanner tools) in access logs.
Findings are heuristic indicators, not proof that an attack succeeded.
"""
import argparse
import glob
import gzip
import os
import re
import sys
from collections import Counter
from urllib.parse import unquote

TOOL_NAME = "ou-log-read-tool"
VERSION = "1.0"

